{
  "name": "naimcine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "build": "npm run build:tv-games && vite build && npm run build:server",
    "build:tv-games": "esbuild src/components/games/racing/tvRacingGlobalEntry.ts --bundle --format=iife --global-name=RiffanRacing3DBundle --target=es2015 --minify --outfile=public/vendor/riffan-racing-3d.iife.js",
    "build:server": "esbuild server.ts server/mediaServer.ts --bundle --platform=node --format=esm --packages=external --out-extension:.js=.mjs --outdir=dist-server",
    "start:compiled": "node dist-server/server.mjs",
    "start:media": "node dist-server/mediaServer.mjs",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-server server.js",
    "lint": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/genai": "^3.3.0",
    "@rive-app/canvas": "^2.55.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-virtual": "^3.14.26",
    "@types/canvas-confetti": "^1.9.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "canvas-confetti": "^1.9.4",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.4",
    "express": "^4.21.2",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.1",
    "gsap": "^3.15.1",
    "hls.js": "^1.7.4",
    "jszip": "^3.10.2",
    "lucide-react": "^0.546.0",
    "modern-screenshot": "^4.7.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pixi.js": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "undici": "^8.13.1",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^2.0.0",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.27.0",
    "eslint": "^10.14.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.1",
    "prettier": "^3.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
