{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true
  },
  "include": [
    "server.ts",
    "server/**/*.ts",
    "src/config/**/*.ts",
    "src/types/providers.ts",
    "src/shared/**/*.ts",
    "src/db/**/*.ts",
    "src/lib/**/*.ts",
    "src/middleware/**/*.ts"
  ]
}
